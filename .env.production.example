HTTP_PORT=8080
APP_ENV=production
ALLOWED_ORIGIN=http://127.0.0.1:8080
SESSION_COOKIE_SECURE=false

POSTGRES_USER=chatbi
POSTGRES_PASSWORD=replace-with-strong-postgres-password
POSTGRES_DB=chatbi
MINIO_ROOT_USER=chatbi
MINIO_ROOT_PASSWORD=replace-with-strong-minio-password
S3_BUCKET=chatbi
MODEL_ROOT=../BAAI

SECRET_KEY=replace-with-at-least-32-random-bytes
BOOTSTRAP_ADMIN_TOKEN=replace-with-at-least-32-random-bytes
MCP_ACCESS_TOKEN=replace-with-at-least-32-random-bytes
DEEPSEEK_API_KEY=replace-with-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
QA_DAILY_LIMIT_PER_USER=200
REPORT_DAILY_LIMIT_PER_USER=30
ADMIN_DATA_DAILY_LIMIT=50
QA_MAX_CONCURRENCY=2
QA_QUEUE_TIMEOUT_SECONDS=15
INGEST_SOFT_TIME_LIMIT=1800
INGEST_TIME_LIMIT=1860
STALE_JOB_HOURS=6
CRAWL_DELAY_SECONDS=1
AUDIT_RETENTION_DAYS=180
